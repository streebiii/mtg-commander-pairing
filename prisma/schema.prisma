// Datenmodell für die Commander-Pairing-App.
// Siehe SPEC.md für die fachlichen Regeln.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Ein Spieler der Liga/des Clubs. Persistent über alle Abende hinweg.
model Player {
  id           String    @id @default(cuid())
  firstName    String
  /// Optional, da der Textimport der Liga-Rangliste manchmal nur einen
  /// Vornamen oder eine Initiale liefert (z.B. "Tyrone", "Marc S.").
  lastName     String?
  /// Aktueller Gesamt-Liga-Punktestand (Saison). Wird nach jeder Modus-B-
  /// Runde um die eingetragenen pointsAwarded erhöht. Modus A ändert dies nie.
  points       Int       @default(0)
  /// An wie vielen Liga-Abenden der Spieler teilgenommen hat, aus den
  /// Rundenspalten der importierten Rangliste gezaehlt. Die Paarung
  /// sortiert nach Punkten **pro Abend**, nicht nach der Gesamtsumme —
  /// sonst landet, wer Abende verpasst hat, systematisch an den unteren
  /// Tischen, unabhaengig von seiner Staerke (siehe SPEC.md 5.1).
  attendedEvenings Int   @default(0)
  /// Subjektive Skill-Einstufung 0-5 (0 = unbekannt, 1 = blutiger Anfänger,
  /// 5 = langjähriger Commander/Magic-Spieler). Nur für die skill-
  /// balancierte Gruppierung in Modus A verwendet (siehe SPEC.md
  /// Abschnitt 4.1), fließt nie in die Liga-Rangliste (Modus B) ein.
  skillLevel   Int       @default(0)
  /// Nimmt der Spieler an der Liga (Modus B) teil? Rein zukunftsgerichtete
  /// Filterung der Auswahlliste für neue Liga-Abende — bestehende Abende/
  /// Ergebnisse bleiben davon unberührt. Neu angelegte Spieler starten mit
  /// false (müssen im Liga-Tab manuell aktiviert werden); bei der Migration
  /// wurden alle bis dahin bestehenden Spieler auf true gesetzt.
  leagueActive Boolean   @default(false)
  /// Gesetzt, wenn der Spieler aus der Oberfläche entfernt wurde, aber
  /// wegen bestehender Abend-Historie nicht hart gelöscht werden konnte
  /// (siehe SPEC.md Abschnitt 6). Archivierte Spieler tauchen in keiner
  /// Liste mehr auf; ihre Tischzuteilungen und Ergebnisse bleiben intakt.
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  assignments TableAssignment[]
  casualSeat  CasualSeat?

  @@map("players")
}

/// Ein Spielabend. mode unterscheidet Modus A (Casual) von Modus B (Liga).
/// Modus-A-Abende dienen nur der Anzeige/aktuellen Zuteilung und fließen
/// bewusst nicht in Saison-Statistiken oder Rematch-Vermeidung ein
/// (siehe SPEC.md Abschnitt 4 und 9).
model Evening {
  id         String      @id @default(cuid())
  mode       EveningMode
  date       DateTime    @default(now())
  /// Gesetzt, sobald der Abend abgeschlossen ist (keine weiteren Runden mehr).
  finishedAt DateTime?
  createdAt  DateTime    @default(now())

  rounds       Round[]
  achievements EveningAchievement[]

  @@map("evenings")
}

enum EveningMode {
  CASUAL // Modus A
  LEAGUE // Modus B
}

/// Eine Runde innerhalb eines Abends (bei Modus B bis zu 3, bei Modus A genau 1).
model Round {
  id        String   @id @default(cuid())
  eveningId String
  evening   Evening  @relation(fields: [eveningId], references: [id], onDelete: Cascade)
  number    Int
  createdAt DateTime @default(now())
  /// Gesetzt, sobald diese Runde auf der öffentlichen Seite sichtbar
  /// gemacht wurde ("Live schalten"). null = Warteraum — nur der
  /// Organisator sieht die Zuteilung, die öffentliche Seite zeigt
  /// weiterhin die zuletzt veröffentlichte Runde (siehe Grill-Notizen).
  publishedAt DateTime?

  tables Table[]

  @@unique([eveningId, number])
  @@map("rounds")
}

/// Ein einzelner Tisch (Pod) innerhalb einer Runde.
model Table {
  id          String @id @default(cuid())
  roundId     String
  round       Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  /// Fortlaufende Tischnummer innerhalb der Runde (1, 2, 3, ...) — nur für die Anzeige.
  tableNumber Int
  /// Tischgröße gemäß Pairing-Algorithmus (3, 4 oder 5).
  size        Int
  /// Gesetzt, sobald der Organisator das Ergebnis dieses Tisches erfasst
  /// hat. Unterscheidet "unentschieden ausgegangen" (gesetzt, aber keine
  /// Zuordnung mit isWinner) von "noch nicht erfasst" (null) — Runde 2
  /// startet erst, wenn für jeden Tisch eines von beidem feststeht.
  resultEnteredAt DateTime?

  assignments TableAssignment[]

  @@unique([roundId, tableNumber])
  @@map("tables")
}

/// Zuordnung eines Spielers zu einem Tisch, inkl. (bei Modus B) erzieltem
/// Punktestand für diese Runde.
model TableAssignment {
  id       String @id @default(cuid())
  tableId  String
  table    Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  /// null, solange das Ergebnis noch nicht eingetragen wurde. Bei Modus A
  /// bleibt dieses Feld immer null.
  ///
  /// Wird seit der Umstellung auf den Tischsieger nicht mehr befüllt: die
  /// Punkte entstehen erst bei der Erfassung am Abendende und wandern von
  /// dort nach mtgbl.ch (siehe BACKLOG.md). Das Feld bleibt vorerst
  /// stehen, damit alte Abende lesbar bleiben.
  pointsAwarded Int?

  /// Sieger der Partie an diesem Tisch. Höchstens eine Zuordnung pro Tisch
  /// trägt true; sind alle false und ist `Table.resultEnteredAt` gesetzt,
  /// ging der Tisch unentschieden aus (Zeitlimit, siehe die Liga-Regeln
  /// auf mtgbl.ch). Sortierschlüssel für die Paarung der zweiten Runde.
  isWinner Boolean @default(false)

  @@unique([tableId, playerId])
  @@map("table_assignments")
}

/// Die *eine* aktuell gültige Casual-Tischzuteilung (siehe SPEC.md
/// Abschnitt 4). Bewusst getrennt von Evening/Round/Table der Liga:
///
/// - Es gibt immer nur die aktuelle Zuteilung. Neu berechnen ersetzt sie,
///   Zurücksetzen löscht sie — kein Verlauf, keine Altlasten.
/// - Sie zählt nicht als Abend-Teilnahme und blockiert deshalb auch nicht
///   das harte Löschen eines Spielers (siehe Abschnitt 6.2).
/// - Sie existiert nur, damit die öffentliche Lese-Ansicht die Tische
///   zeigen kann; ohne sie sähe sie niemand ausser dem Organisator.
model CasualSeat {
  id          String @id @default(cuid())
  /// Fortlaufende Tischnummer (1, 2, 3, ...) — nur für die Anzeige.
  tableNumber Int
  playerId    String
  /// Cascade: wird ein Spieler geloescht, verschwindet auch sein Platz.
  /// Die Casual-Zuteilung ist fluechtig und darf ein Loeschen nie blockieren.
  player      Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([playerId])
  @@index([tableNumber])
  @@map("casual_seats")
}

/// Ein Achievement aus dem Katalog der Liga (siehe SPEC.md Abschnitt 11).
/// Massgeblich ist die Liste auf mtgbl.ch; die Startdaten stammen von dort
/// (Migration `add_achievements`), gepflegt wird danach im Achievements-Tab.
/// Achievements werden nie gelöscht, nur inaktiv gestellt — vergangene
/// Abende tragen ohnehin eine eigene Kopie (EveningAchievement).
model Achievement {
  id          String              @id @default(cuid())
  title       String
  description String
  /// Punkte pro Erfüllung. Variable Werte der Website («+2/+1») werden
  /// mit dem höheren Wert geführt und bei der Erfassung korrigiert.
  points      Int
  category    AchievementCategory
  /// Wie oft das Achievement zählen kann. Folgt meist aus der Kategorie,
  /// ist aber ein eigenes Feld, damit Ausnahmen wie Evergreen (Deckbau,
  /// aber einmal pro Liga) nicht im Code stecken. PER_PLAYER und MULTIPLE
  /// zählen mehrfach — die Erfassung zeigt dort ein Anzahl-Feld statt
  /// eines Häkchens.
  scope       AchievementScope
  /// Gilt an Liga-Abenden: der Abendstart übernimmt alle aktiven. Bei den
  /// rotierenden heisst aktiv «gehört zur aktuellen Ziehung» — nach jeder
  /// Ziehung auf mtgbl.ch werden die neuen 10 aktiv und die alten inaktiv
  /// gestellt (siehe SPEC.md Abschnitt 11.2).
  active      Boolean             @default(true)
  /// Reihenfolge wie auf mtgbl.ch, innerhalb der Kategorie.
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())

  eveningAchievements EveningAchievement[]

  @@index([category, sortOrder])
  @@map("achievements")
}

enum AchievementCategory {
  FIXED        // fix, gilt jeden Abend
  DECKBUILDING // Deckbau, gilt jeden Abend
  ROTATING     // rotierend, 10 pro Abend
}

enum AchievementScope {
  MATCH      // 1x pro Match
  EVENING    // 1x pro Abend
  SEASON     // 1x am Ende der Liga
  PER_PLAYER // pro Spieler (z.B. je eliminiertem Spieler)
  MULTIPLE   // mehrmals pro Abend
}

/// Ein an einem Liga-Abend geltendes Achievement — eine eingefrorene
/// Kopie aus dem Katalog. Spätere Katalogänderungen schreiben vergangene
/// Abende damit nicht um (siehe BACKLOG.md).
model EveningAchievement {
  id            String              @id @default(cuid())
  eveningId     String
  evening       Evening             @relation(fields: [eveningId], references: [id], onDelete: Cascade)
  /// Herkunft im Katalog. Bleibt gesetzt, solange es das Achievement gibt;
  /// verhindert, dass dasselbe Achievement doppelt an einem Abend gilt.
  achievementId String?
  achievement   Achievement?        @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  title         String
  description   String
  points        Int
  category      AchievementCategory
  scope         AchievementScope
  sortOrder     Int

  @@unique([eveningId, achievementId])
  @@map("evening_achievements")
}

/// Einmal-Code für den passwortlosen Email-Login (siehe SPEC.md
/// Abschnitt 2). Es gibt keine Benutzerkonten — jeder gültige,
/// unverbrauchte Code innerhalb seiner Gültigkeit loggt als der eine
/// Organisator ein.
model LoginToken {
  id String @id @default(cuid())

  /// SHA-256-Hash des sechsstelligen Codes. Nur der Code selbst steht in
  /// der Email, niemals im Klartext in der Datenbank — falls die DB je
  /// ausgelesen würde, liessen sich daraus keine gültigen Codes ableiten.
  /// Bewusst nicht unique: zwei gleichzeitig gültige Codes könnten
  /// theoretisch dieselben sechs Ziffern haben.
  tokenHash String

  /// Zahl der Fehlversuche, seit dieser Code ausgestellt wurde. Ein
  /// sechsstelliger Code hat nur eine Million Möglichkeiten — ohne diese
  /// Bremse wäre er in Minuten durchprobiert. Bei jedem Fehlversuch wird
  /// der Zähler aller offenen Codes erhöht; ab MAX_CODE_ATTEMPTS gilt der
  /// Code als verbrannt (siehe src/lib/loginToken.ts).
  attempts Int @default(0)

  expiresAt DateTime
  /// null, solange der Code noch nicht eingelöst wurde. Ein Code ist
  /// nach einmaligem Einlösen ungültig (Replay-Schutz).
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([createdAt])
  @@map("login_tokens")
}

# PostgreSQL-Verbindung. Lokal: die Datenbank aus docker-compose.yml
# (docker compose up -d), in Produktion: die von Vercel Postgres
# bereitgestellte Verbindungs-URL (wird beim Anlegen des Postgres-Stores
# in Vercel automatisch als Environment-Variable eingetragen).
DATABASE_URL="postgresql://pairing:dev-password@localhost:5432/pairing_dev"

# Zufälliger, langer Secret-String zum Signieren des Login-Session-Cookies.
# Erzeugen z.B. mit: openssl rand -base64 32
SESSION_SECRET="change-me"

# Email-Adresse, an die Login-Links verschickt werden (nur diese eine
# Adresse kann sich einloggen — kein Passwort mehr, siehe SPEC.md
# Abschnitt 2).
ADMIN_EMAIL="du@example.com"

# SMTP-Zugangsdaten zum Email-Versand (von deinem cyon-Hosting).
SMTP_HOST="mail.cyon.ch"
SMTP_PORT="465"
SMTP_USER="deine-email@deine-domain.ch"
SMTP_PASSWORD="dein-email-postfach-passwort"
# Absenderadresse; falls leer, wird SMTP_USER verwendet. Muss zur selben
# Domain gehören wie das cyon-Postfach, sonst blockt cyon den Versand.
SMTP_FROM="deine-email@deine-domain.ch"

# Basis-URL der App für absolute Links im Login-Email. Auf Vercel wird
# automatisch VERCEL_URL verwendet — APP_URL nur setzen, wenn du eine
# eigene Domain nutzt oder lokal testest.
# APP_URL="https://deine-domain.ch"

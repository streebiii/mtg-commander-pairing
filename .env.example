# PostgreSQL-Verbindung. Lokal: die Datenbank aus docker-compose.yml
# (docker compose up -d), in Produktion: die von Vercel Postgres
# bereitgestellte Verbindungs-URL (wird beim Anlegen des Postgres-Stores
# in Vercel automatisch als Environment-Variable eingetragen).
DATABASE_URL="postgresql://pairing:dev-password@localhost:5432/pairing_dev"

# Zufälliger, langer Secret-String zum Signieren des Login-Session-Cookies.
# Erzeugen z.B. mit: openssl rand -base64 32
SESSION_SECRET="change-me"

# Passwort für den Organisator-Login (siehe SPEC.md Abschnitt 2). Lang und
# zufällig wählen; es steht nur hier und in den Vercel-Umgebungsvariablen,
# nie im Repository. Ohne diese Variable kann sich niemand anmelden.
ADMIN_PASSWORD="ein-langes-zufaelliges-passwort"
